# Exemplo para dev com Postgres (docker-compose up -d db).
# Copie o DATABASE_URL abaixo para backend/.env quando quiser testar Postgres.
# Mantenha uma cópia do SQLite (viabilidades.db) antes de migrar.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/viabilidades

SECRET_KEY=troque_por_chave_forte_em_producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=*
