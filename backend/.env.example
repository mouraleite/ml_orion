# Copie para .env e ajuste conforme o ambiente.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# --- Ambiente ---
# development = login com dummy-token-for-dev e CORS permissivo.
# production  = só JWT real; CORS * vira localhost:3000 se não houver lista explícita.
ENVIRONMENT=development

# --- Banco ---
DATABASE_URL=sqlite:///./viabilidades.db
# Produção (exemplo):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/erp_ml
#
# Dev Postgres (docker-compose): veja backend/.env.postgres.example

# --- Segurança (JWT) ---
# Gerar em produção: openssl rand -hex 32
SECRET_KEY=troque_por_chave_forte_em_producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Redis (filas / cache futuro) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (origens permitidas, separadas por vírgula) ---
# Dev no PC: * costuma bastar. Produção: https://seu-dominio,http://localhost:3000
CORS_ORIGINS=*

# --- Microsoft Entra ID (SSO) ---
# App Registration (SPA). Vazio = botão Microsoft não autentica de verdade.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Sienge API ---
SIENGE_SUBDOMAIN=mouraleite
SIENGE_USER=mouraleite-contas-a-pagar
SIENGE_PASS=troque_em_producao
