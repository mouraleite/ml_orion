# Modelo de produção — NÃO sobrescreve o .env de desenvolvimento.
# Copie para o servidor como .env e preencha os valores reais.

ENVIRONMENT=production

# Postgres de produção (NUNCA sqlite em produção multi-usuário)
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST:5432/viabilidades

# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_CHAVE_FORTE_64_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

REDIS_URL=redis://localhost:6379/0

# Domínios HTTPS reais (vírgula). Nunca use * em production.
CORS_ORIGINS=https://SEU-DOMINIO.com.br,https://www.SEU-DOMINIO.com.br

# Mesmas credenciais Sienge do ambiente atual
SIENGE_SUBDOMAIN=mouraleite
SIENGE_USER=
SIENGE_PASS=

# Microsoft Entra ID (App Registration SPA)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
